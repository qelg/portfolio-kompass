#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  printf '\n==> %s\n' "$label"
  time "$@"
}

node_major="$(node --version | sed -E 's/^v([0-9]+).*/\1/')"
if ((node_major < 22)); then
  printf 'Portfolio Kompass requires Node.js 22 or newer (found %s).\n' "$(node --version)" >&2
  exit 1
fi

export NEXT_TELEMETRY_DISABLED=1

pnpm_spec="$(node -p "require('./package.json').packageManager")"
pnpm_version="${pnpm_spec#pnpm@}"
installed_pnpm_version="$(pnpm --version 2>/dev/null || true)"
if [[ "$installed_pnpm_version" != "$pnpm_version" ]]; then
  step "Install pnpm ${pnpm_version}" npm install --global --force "$pnpm_spec"
fi
step "Install JavaScript dependencies" pnpm install --frozen-lockfile

printf '\nOrb setup complete (Node %s, pnpm %s).\n' "$(node --version)" "$(pnpm --version)"
