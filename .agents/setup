#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  printf '\n==> %s\n' "$label"
  time "$@"
}

install_nix() {
  local installer
  installer="$(mktemp)"
  if ! curl --proto '=https' --tlsv1.2 --fail --location \
    https://nixos.org/nix/install --output "$installer" || \
    ! sh "$installer" --no-daemon --yes --no-channel-add; then
    rm -f "$installer"
    return 1
  fi
  rm -f "$installer"
}

load_dev_shell() {
  eval "$(nix --extra-experimental-features 'nix-command flakes' print-dev-env "$repo_root")"
}

nix_profile="$HOME/.nix-profile"
if [[ ! -x "$nix_profile/bin/nix" ]]; then
  step "Install Nix" install_nix
fi

# The installer cannot update this running process.
# shellcheck disable=SC1091
source "$nix_profile/etc/profile.d/nix.sh"

profile_marker="# portfolio-kompass Nix development shell"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ -z "\${PORTFOLIO_KOMPASS_NIX_ENV:-}" && "\${PWD}" == "$repo_root" ]]; then
  export PORTFOLIO_KOMPASS_NIX_ENV=1
  eval "\$("$nix_profile/bin/nix" --extra-experimental-features 'nix-command flakes' print-dev-env "$repo_root")"
fi
EOF
fi

step "Load the Nix development shell" load_dev_shell

pnpm_spec="$(node -p "require('./package.json').packageManager")"
pnpm_version="${pnpm_spec#pnpm@}"
installed_pnpm_version="$(pnpm --version 2>/dev/null || true)"
if [[ "$installed_pnpm_version" != "$pnpm_version" ]]; then
  printf 'The Nix development shell provides pnpm %s, but package.json pins %s.\n' \
    "$installed_pnpm_version" "$pnpm_version" >&2
  exit 1
fi
step "Install JavaScript dependencies" pnpm install --frozen-lockfile

printf '\nOrb setup complete (Node %s, pnpm %s).\n' "$(node --version)" "$(pnpm --version)"
